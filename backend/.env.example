# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Security & CORS
# In production, set to your frontend production domain (e.g., https://kavyashreenursing.edu.in)
FRONTEND_ORIGIN=http://localhost:4200

# Database Configuration
# Leave unset for local development to use the built-in local dev store.
# Set to your MongoDB Atlas connection string in production (never commit real values).
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/kavya_shree_nursing?retryWrites=true&w=majority

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENQUIRY_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# Authentication & JWT Security
# Production requires at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
JWT_EXPIRES_IN=8h

# Initial Administrator Provisioning (used by npm run seed:admin against a real MongoDB)
ADMIN_SEED_EMAIL=<admin-email>
ADMIN_SEED_PASSWORD=<strong-password-min-12-chars>
ADMIN_SEED_NAME=Institute Administrator

# Local dev store administrator (development only, ignored in production).
# If unset, no administrator is created in a fresh local dev store.
# DEV_ADMIN_EMAIL=<dev-admin-email>
# DEV_ADMIN_PASSWORD=<dev-admin-password>
