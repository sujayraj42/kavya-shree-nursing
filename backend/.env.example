# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
# Strict production validation (enabled by default when NODE_ENV=production)
STRICT_PRODUCTION_CONFIG=true
# Reverse proxy hop depth (defaults to 1 in production behind Render)
TRUST_PROXY=1

# Security & CORS
# In production, set to your frontend production domain (e.g., https://kavya-shree-nursing.vercel.app)
FRONTEND_ORIGIN=http://localhost:4200

# Database Configuration
# Leave unset for local development to use the built-in local dev store.
# Set to your MongoDB Atlas connection string in production (never commit real values).
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/kavya_shree_nursing?retryWrites=true&w=majority

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENQUIRY_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# Render Keep-Alive Self-Ping (disabled by default when using GitHub Actions keep-alive workflow)
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL_MS=600000
# KEEP_ALIVE_URL=https://kavya-shree-nursing.onrender.com

# Authentication & JWT Security
# Production requires at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
JWT_EXPIRES_IN=8h

# Initial Administrator Provisioning (used by npm run seed:admin against a real MongoDB)
ADMIN_SEED_EMAIL=<admin-email>
ADMIN_SEED_PASSWORD=<strong-password-min-8-chars-recommended-12+>
ADMIN_SEED_NAME=Institute Administrator

# Local dev store administrator (development only, ignored in production).
# If unset, no administrator is created in a fresh local dev store.
# DEV_ADMIN_EMAIL=<dev-admin-email>
# DEV_ADMIN_PASSWORD=<dev-admin-password>

# Automation & Notification Integrations (Optional)
# Instant Telegram notifications to admission staff on new enquiry / application:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=-1001234567890
# External webhook for Google Sheets / CRM sync (Zapier, Make, n8n, Google Apps Script):
# WEBHOOK_LEAD_URL=https://script.google.com/macros/s/your-app-id/exec
# WEBHOOK_STATUS_URL=https://hooks.zapier.com/hooks/catch/your-id/
